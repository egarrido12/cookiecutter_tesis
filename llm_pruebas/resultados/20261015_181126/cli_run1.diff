+def _resolve_accept_hooks(accept_hooks: Literal['yes', 'ask', 'no']) -> bool:
+    """Decide whether pre/post hooks must run, asking the user if needed."""
+    if accept_hooks == "ask":
+        return click.confirm("Do you want to execute hooks?")
+    return accept_hooks == "yes"
